{
  "api_domain": {
    "type": "string",
    "description": "CopyManga API域名",
    "default": "api.copymanga.site",
    "options": ["api.copymanga.site", "api.copymanga.cn", "api.copymanga.net"]
  },
  "custom_api_domain": {
    "type": "string",
    "description": "自定义API域名，仅当api_domain_mode为Custom时生效",
    "default": ""
  },
  "api_domain_mode": {
    "type": "string",
    "description": "API域名模式",
    "default": "Default",
    "options": ["Default", "Custom"]
  },
  "download_dir": {
    "type": "string",
    "description": "漫画下载目录",
    "default": "./downloads"
  },
  "export_dir": {
    "type": "string",
    "description": "漫画导出目录",
    "default": "./exports"
  },
  "token": {
    "type": "string",
    "description": "CopyManga登录令牌",
    "default": "",
    "obvious_hint": true
  },
  "search_limit": {
    "type": "int",
    "description": "搜索结果最大返回数量",
    "default": 20,
    "minimum": 1,
    "maximum": 100
  },
  "chapter_content_mode": {
    "type": "string",
    "description": "章节内容返回方式，merge表示合并转发整章内容，single表示单页发送",
    "default": "single",
    "options": ["merge", "single"]
  },
  "search_display_limit": {
    "type": "int",
    "description": "一次合并转发消息最多显示的漫画数量",
    "default": 10,
    "minimum": 1,
    "maximum": 50
  },
  "command_copymanga_login": {
    "description": "登录命令配置，用于登录CopyManga账号",
    "type": "object",
    "items": {
        "enabled": {
            "description": "是否启用该命令",
            "type": "bool",
            "default": true
        },
        "command_name": {
            "description": "命令名称",
            "type": "string",
            "hint": "自定义命令名称，例如 'copymanga_login'",
            "default": "copymanga_login"
        }
    }
  },
  "command_copymanga_search": {
    "description": "搜索命令配置，用于搜索漫画",
    "type": "object",
    "items": {
        "enabled": {
            "description": "是否启用该命令",
            "type": "bool",
            "default": true
