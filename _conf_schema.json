        "command_name": {
            "description": "命令名称",
            "type": "string",
            "hint": "自定义命令名称，例如 'copymanga_search'",
            "default": "copymanga_search"
        }
    }
  },
  "command_copymanga_select_comic": {
    "description": "选择漫画命令配置，用于选择搜索结果中的漫画",
    "type": "object",
    "items": {
        "enabled": {
            "description": "是否启用该命令",
